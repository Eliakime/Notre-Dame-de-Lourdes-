# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_UPLOAD_TOKEN=
# Optional absolute path to a persistent storage directory.
# DOCUMENTS_DIR=
# Recommended on Vercel: connect a private Vercel Blob store to the project.
# Vercel provides BLOB_STORE_ID when connecting with OIDC authentication.
# BLOB_STORE_ID=
# Alternatively, use a read-write token instead of OIDC.
BLOB_READ_WRITE_TOKEN=
